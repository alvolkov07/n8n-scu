    {
      "parameters": {
        "promptType": "define",
        "text": "=Articles from the last 24 hours (JSON):\n{{ JSON.stringify($json.articles) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a strict editor for a senior AI/tech audience. Score each article from 1 to 10.\nHigh scores (8-10): original research (papers, benchmarks, new methods, model releases with technical detail), and hands-on engineering (working code, reproducible experiments, practical tooling, deep technical write-ups).\nOfficial announcements from frontier AI labs (OpenAI, Anthropic, Google DeepMind, xAI, Meta AI, Mistral, NVIDIA) about new models, major model updates or research results score at least 7.\nMedium (5-7): solid analysis or announcements with real substance but little technical depth.\nLow (1-4): marketing, funding/hiring news, listicles, opinion without evidence, rehashed news, event promos, podcasts without notes.\nCategory must be one of: Research, Hands-on, Industry, Analysis.\nReturn every article you were given, with title, link and source copied exactly."
            }
          ]
        },
        "batching": {}
      },
