      "parameters": {
        "jsonSchemaExample": "{\n  \"visuals\": [\n    { \"index\": 0, \"diagramHtml\": \"<table role='presentation' width='100%' style='border-collapse:collapse;font-family:Arial,sans-serif'><tr><td style='background:#eef4ff;padding:12px;border-radius:8px'>Before</td><td style='padding:0 8px'>&rarr;</td><td style='background:#e8f8ee;padding:12px;border-radius:8px'>After</td></tr></table>\" }\n  ]\n}"
      },
      "id": "2c531026-2ee2-4c84-a5a1-d4956cc68581",
      "name": "Visuals Format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        3760,
        320
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Date: {{ $now.toFormat(\"MMMM d, yyyy\") }}\nSelected articles (JSON, each with its index):\n{{ JSON.stringify(($('Bundle Top Articles').item.json.top || []).map((a, i) => ({ index: i, ...a }))) }}\nArticle indexes that have a diagram: {{ JSON.stringify((($json.output || {}).visuals || []).map(v => v.index)) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You write a concise daily AI & tech briefing for practitioners, including integrated visual diagrams for specific articles.\nGroup items by category (Research, Hands-on, Industry, Analysis). For each section where there is no article, please still keep the section in and empty. For each item give the linked title, source, and a summary of the article's contents and its significance. Start with a 2-3 sentence \"Top takeaways\" section.\nUse only the articles provided. Never invent links or facts. Prioritize the links based on relevance.\nEvery article title must be a clickable link: <a href=\"LINK\">Title</a>, using the exact link from the input.\nFor every article whose index is in the list of indexes that have a diagram, put the marker [[VISUAL:index]] on its own line directly after that article's summary in emailHtml (for example [[VISUAL:3]]). Do not write the diagram yourself; the marker is replaced with the diagram later. Do not add markers for other articles.\nProduce emailHtml (clean HTML with inline styles only, no <html>/<body>/<style> tags), slackText, and docText (plain text for a document, with links written out in full, no markers)."
            }
          ]
        },
        "batching": {}
      },
