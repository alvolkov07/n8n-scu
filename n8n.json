    {
      "parameters": {
        "promptType": "define",
        "text": "=Selected articles (JSON, each with its index):\n{{ JSON.stringify(($json.top || []).map((a, i) => ({ index: i, title: a.title, link: a.link, source: a.source, category: a.category, why: a.why }))) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You design small inline visual diagrams for an HTML email briefing about AI and tech news.\nDecide for each article whether it describes a clear technical advance that a diagram can explain: new model performance, research methods, software or systems improvements, AI engineering, or step-by-step guides. Skip business, funding, IPO, personnel, policy and pure marketing news. Make a diagram for at most 6 articles.\nFor each chosen article return its index and diagramHtml: a self-contained HTML snippet that shows the innovation visually, for example a before/after comparison, a 3-4 step pipeline with arrows, or simple bar-style metric comparison.\nStrict email rules (Gmail strips anything else): use only <table>, <tr>, <td>, <div>, <span>, <b>, <br> with inline style attributes. No <style>, <script>, <svg>, <img>, classes, external fonts or CSS variables. Use Arial/Helvetica, a clean white or very light background, soft accent colors, rounded boxes, and &rarr; arrows. Max width 560px. Keep text short and readable by a non-expert.\nBase every diagram only on the title, source and notes given. Never invent numbers or facts that are not in the input; use qualitative labels instead.\nIf no article qualifies, return an empty visuals array."
            }
          ]
        },
        "batching": {}
      },
      "id": "24fb2ff7-a937-4f3d-b136-269e6c1fe27d",
      "name": "Design Article Visuals",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        3616,
        96
      ]
    },
    {
      "parameters": {
